# Copy to .env.local and fill in. .env.local is gitignored — it never reaches
# GitHub, and `npm run` loads it automatically, so you never type a token on
# the command line or leave one in your shell history.
#
#   cp .env.local.example .env.local
#
# Tokens are created at:
#   https://www.sanity.io/manage/project/8og1x4eu/api#tokens

# ---- Which project and dataset everything points at -------------------------
# Public identifiers, not secrets. Both are defaulted in code, so things work
# without them — set them anyway so switching dataset is a config change.
PUBLIC_SANITY_PROJECT_ID=8og1x4eu
PUBLIC_SANITY_DATASET=production

# ---- Writing: scripts only, NEVER Vercel ------------------------------------
# Needs the Editor role. This is full write access to the dataset: it can
# create, overwrite and delete any document. It belongs on your machine and
# nowhere else. The deployed site never writes, so it never needs this.
SANITY_WRITE_TOKEN=

# ---- Reading: the site build ------------------------------------------------
# Viewer role. Only needed if the dataset is private; `production` is currently
# public, so the site builds fine without it. These two DO belong in Vercel.
SANITY_READ_TOKEN=
SANITY_VIEWER_TOKEN=

# Any random string. Only needed if you want /preview/... draft previews.
PREVIEW_SECRET=

# ---- Rarely needed ----------------------------------------------------------
# Overrides the Sanity API hostname. Leave empty unless you have been told to
# set it.
PUBLIC_SANITY_API_HOST=
