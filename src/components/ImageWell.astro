---
/*
 * Photography tolerance, factored out — Component Spec §3.1 / §4.3.
 *
 * The image sits in a --surface-sunken well at a fixed ratio with
 * object-fit: cover. No rounding, no border, no overlay gradient — a
 * white-background product shot and a dark lifestyle shot both read as
 * intentional against the warm well.
 *
 * With no image, renders the fallback tile: --surface-accent field at the same
 * ratio with a "CS" monogram in Playfair. aria-hidden, no text label — the
 * "No image · fallback" caption in the prototype is a spec annotation, not
 * content, and must not ship (§6). Never substitute a stock photo.
 */
import type { ImageRef } from "../lib/types";
import { responsive } from "../sanity/lib/image";

interface Props {
  image?: ImageRef;
  /** Any aspect-ratio value; pass a --ratio-* token. */
  ratio?: string;
  /** Numeric width/height for the crop, e.g. 3/2. Must match `ratio`. */
  cropRatio?: number;
  /** The `sizes` attribute — pick one from SIZES. */
  sizes?: string;
  /** Fallback monogram size. */
  monogram?: string;
  /** Hover scale is driven by an ancestor carrying .is-card. */
  class?: string;
  loading?: "lazy" | "eager";
}

const {
  image,
  ratio = "var(--ratio-card)",
  cropRatio = 3 / 2,
  sizes,
  monogram = "40px",
  class: className,
  loading = "lazy",
} = Astro.props;

/*
 * Sanity's hotspot is honoured by the crop itself (fit: crop), so the rendered
 * <img> does not also need object-position — asking for both double-applies the
 * offset and pushes the subject out of frame.
 */
const src = image ? responsive(image, { ratio: cropRatio, max: 1200 }) : null;
---

<div
  class:list={["well", !image && "well--fallback", className]}
  style={`--well-ratio: ${ratio}; --well-monogram: ${monogram};${image?.lqip ? ` background-image: url(${image.lqip});` : ""}`}
>
  {
    image && src ? (
      <img
        src={src.src}
        srcset={src.srcset}
        sizes={sizes}
        alt={image.alt}
        width={src.width}
        height={src.height}
        loading={loading}
        decoding="async"
      />
    ) : (
      <span class="well__monogram" aria-hidden="true">
        CS
      </span>
    )
  }
</div>

<style>
  .well {
    aspect-ratio: var(--well-ratio);
    background-color: var(--surface-sunken);
    /* Sanity's LQIP — a tiny blurred JPEG held behind the real image. */
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-0);
    overflow: hidden;
  }

  .well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur) var(--ease);
  }

  .well--fallback {
    background: var(--surface-accent);
    display: flex;
    align-items: flex-end;
    padding: 18px;
  }

  .well__monogram {
    font-family: var(--font-serif);
    font-size: var(--well-monogram);
    line-height: 1;
    color: var(--monogram);
  }

  /* §3.1 Hover: image scales 1.02 inside the fixed well; nothing lifts or shadows. */
  :global(.is-card:hover) .well img {
    transform: scale(1.02);
  }

  /* §5 — reduced motion disables the image scale. */
  @media (prefers-reduced-motion: reduce) {
    :global(.is-card:hover) .well img {
      transform: none;
    }
  }

  /* §3.1 Touch: no hover transform. */
  @media (hover: none) {
    :global(.is-card:hover) .well img {
      transform: none;
    }
  }
</style>
