---
/*
 * Component Spec §4.6 — callout. tone: tip | caution.
 *
 * The TOP RULE is the tone signal — colour alone never carries it. The
 * non-colour cue is the label text ("Tip" / "Watch out").
 * Both tones: no icon, no left border, no rounding.
 *
 * Absent label: the default is used. An EMPTY STRING suppresses the label row
 * entirely — so the check below is for `undefined`, not for falsiness.
 */
import { PortableText } from "astro-portabletext";
import type { CalloutNode } from "../../lib/types";

interface Props {
  node: CalloutNode;
}

const { node } = Astro.props as Props;
const { tone, label, body } = node;
const resolvedLabel = label === undefined ? (tone === "tip" ? "Tip" : "Watch out") : label;
---

<aside class:list={["block", "callout", `callout--${tone}`]}>
  {resolvedLabel !== "" && <span class="callout__label">{resolvedLabel}</span>}
  <div class="callout__body">
    <PortableText value={body} />
  </div>
</aside>

<style>
  .callout {
    padding: clamp(18px, 2.2cqw, 26px);
    border-radius: var(--radius-0);
  }

  .callout--tip {
    background: var(--surface-accent-soft);
    border-top: 2px solid var(--brand-green);
  }

  .callout--caution {
    background: var(--surface-warn);
    border-top: 2px solid var(--accent);
  }

  .callout__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: var(--type-eyebrow-ls);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .callout--tip .callout__label {
    color: var(--brand-green);
  }

  .callout--caution .callout__label {
    color: var(--accent-hover);
  }

  /* §4.6 — body capped at --measure-narrow. */
  .callout__body {
    max-width: var(--measure-narrow);
  }

  .callout__body :global(p),
  .callout__body :global(li) {
    margin: 0;
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-lh);
    color: var(--text-body);
  }

  .callout__body :global(p + p),
  .callout__body :global(ul),
  .callout__body :global(ol) {
    margin-top: var(--space-3);
  }

  .callout__body :global(ul),
  .callout__body :global(ol) {
    padding-left: 22px;
  }

  .callout__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* §4.6 Mobile — padding 18px, full measure width, block spacing 32px.
     Never side-by-side with text. */
  @media (max-width: 599px) {
    .callout {
      padding: 18px;
      margin-block: 32px;
    }
  }
</style>
