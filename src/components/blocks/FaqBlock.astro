---
/*
 * Component Spec §4.8 — faqBlock. display: open | accordion.
 *
 * Marked up as FAQPage → Question → acceptedAnswer, plus a matching JSON-LD
 * block in head (emitted by the post page).
 *
 * In `accordion` mode the ANSWERS STAY IN THE DOM when collapsed — a height
 * animation with `hidden` toggled, not a conditional render — so the FAQPage
 * markup always validates.
 *
 * Also available as post.faq at document level, rendered by the same component
 * between the article body and the end CTA. One FAQ per page maximum: if both
 * exist the body block wins and the document field is ignored (validate).
 */
import type { FaqItem } from "../../lib/types";

interface Props {
  eyebrow?: string;
  items: FaqItem[];
  display?: "open" | "accordion";
  /** Set when this is the document-level FAQ rather than an inserted block. */
  standalone?: boolean;
}

const { eyebrow = "Common questions", items, display = "open", standalone = false } = Astro.props;
---

<section
  class:list={[!standalone && "block", "faq", `faq--${display}`]}
  itemscope
  itemtype="https://schema.org/FAQPage"
>
  <div class="rule-head faq__head">
    <span class="eyebrow">{eyebrow}</span>
    <span class="rule-head__line"></span>
  </div>

  <div class="faq__items">
    {
      items.map((item, index) => (
        <div class="faq__item" itemprop="mainEntity" itemscope itemtype="https://schema.org/Question">
          {display === "accordion" ? (
            <h3 class="faq__question">
              <button
                type="button"
                class="faq__trigger"
                aria-expanded="false"
                aria-controls={`faq-answer-${index}`}
                data-faq-trigger
              >
                <span itemprop="name">{item.question}</span>
                <span class="faq__glyph" aria-hidden="true">
                  +
                </span>
              </button>
            </h3>
          ) : (
            <h3 class="faq__question" itemprop="name">
              {item.question}
            </h3>
          )}

          <div
            class="faq__answer"
            id={`faq-answer-${index}`}
            itemprop="acceptedAnswer"
            itemscope
            itemtype="https://schema.org/Answer"
            hidden={display === "accordion"}
          >
            {item.answer.map((paragraph) => (
              <p itemprop="text">{paragraph}</p>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-faq-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const expanded = trigger.getAttribute("aria-expanded") === "true";
      const id = trigger.getAttribute("aria-controls");
      const answer = id ? document.getElementById(id) : null;
      trigger.setAttribute("aria-expanded", String(!expanded));
      if (answer) answer.hidden = expanded;
      const glyph = trigger.querySelector(".faq__glyph");
      if (glyph) glyph.textContent = expanded ? "+" : "−";
    });
  });
</script>

<style>
  .faq__head {
    margin-bottom: var(--space-5);
  }

  /* Items divided by 1px --border rules; first has a top rule, last a bottom. */
  .faq__item {
    border-top: 1px solid var(--border);
    padding-block: var(--space-5);
  }

  .faq__items > .faq__item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .faq__question {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--type-h3-size);
    line-height: 1.3;
    letter-spacing: -0.012em;
    font-weight: 800;
    color: var(--text-primary);
  }

  .faq__answer {
    margin-top: 9px;
  }

  .faq__answer p {
    margin: 0;
    font-size: var(--type-body-sm-size);
    line-height: 1.72;
    color: var(--text-on-accent-body);
    /* §4.8 — answer capped at --measure-narrow. */
    max-width: var(--measure-narrow);
  }

  .faq__answer p + p {
    margin-top: var(--space-3);
  }

  /* ---- accordion --------------------------------------------------------- */
  .faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: none;
    border: 0;
    padding: 0;
    /* §4.8 Mobile — 44px minimum with the whole row as the target. */
    min-height: 44px;
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-align: left;
  }

  .faq__glyph {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    flex-shrink: 0;
  }

  /* §4.8 Mobile — same single column at every width; question floors at 17px
     (the bottom of --type-h3-size's clamp is 18px, so nudge it), padding 18px. */
  @media (max-width: 599px) {
    .faq__item {
      padding-block: 18px;
    }

    .faq__question {
      font-size: 17px;
    }
  }
</style>
