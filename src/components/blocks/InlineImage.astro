---
/*
 * Component Spec §4.3 — inlineImage.
 *
 * Image in a --surface-sunken well at a fixed ratio, object-fit: cover,
 * --radius-0. Caption 10px below, preceded by a 2px --border-accent vertical
 * flag so it can't be misread as body copy. The --accent flag is reserved for
 * the hero (§3.7). Credit appends to the caption after an em dash.
 *
 * Absent caption: no caption row and no rule; the image's bottom margin does
 * not change. An image block with no alt fails schema validation — the one
 * hard block — so a missing alt here means the CMS let something through and
 * we fail the build rather than shipping it.
 *
 * The block IS the image: Sanity spreads the asset fields onto the node, so
 * `node` carries src/alt/hotspot alongside width and ratio.
 */
import type { InlineImageNode } from "../../lib/types";
import { SIZES, responsive } from "../../sanity/lib/image";

interface Props {
  node: InlineImageNode;
}

const { node } = Astro.props as Props;
const image = node;
const { caption, credit, width = "measure", ratio = "3/2" } = image;

if (!image.alt) {
  throw new Error(
    `inlineImage: alt is required (§4.3). Missing on ${image.src}. Sanity validation should have caught this.`,
  );
}

const [w, h] = ratio.split("/").map(Number);
const src = responsive(image, { ratio: w / h, max: width === "wide" ? 2000 : 1600 });
const text = [caption, credit].filter(Boolean).join(" — ");
---

<figure class:list={["block", width === "wide" && "block--wide", "inline-image"]}>
  <div
    class="inline-image__well"
    style={`--img-ratio: ${w} / ${h};${image.lqip ? ` background-image: url(${image.lqip});` : ""}`}
  >
    <img
      src={src.src}
      srcset={src.srcset}
      sizes={width === "wide" ? SIZES.hero : SIZES.body}
      alt={image.alt}
      width={src.width}
      height={src.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {
    text && (
      <figcaption class="inline-image__caption">
        <span class="inline-image__flag" aria-hidden="true" />
        <span>{text}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .inline-image {
    margin-inline: 0;
  }

  .inline-image__well {
    aspect-ratio: var(--img-ratio);
    background-color: var(--surface-sunken);
    /* The LQIP is a tiny blurred JPEG; scaling it up is the point. */
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-0);
    overflow: hidden;
  }

  .inline-image__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .inline-image__caption {
    margin-top: 10px;
    display: flex;
    gap: 10px;
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
    color: var(--text-caption);
  }

  .inline-image__flag {
    width: 2px;
    flex-shrink: 0;
    background: var(--border-accent);
  }
</style>
