---
/*
 * Component Spec §4.3 — imagePair.
 *
 * Exactly 2 images, a 14px gap, equal columns, one shared crop (both identical).
 *
 * CALL MADE (§7): the pair STAYS TWO-UP DOWN TO 390px. The 4/5 crop at ~170px
 * wide still reads, and stacking it would break the comparison the pair exists
 * to make. Below 340px it stacks. Captions stay under their own image.
 */
import type { ImagePairNode } from "../../lib/types";
import { SIZES, responsive } from "../../sanity/lib/image";

interface Props {
  node: ImagePairNode;
}

const { node } = Astro.props as Props;
const { images, ratio = "4/5" } = node;

for (const image of images) {
  if (!image.alt) {
    throw new Error(`imagePair: alt is required on both images (§4.3). Missing on ${image.src}.`);
  }
}

const [w, h] = ratio.split("/").map(Number);
// Half the measure, so 800px covers a 2x display.
const sources = images.map((image) => responsive(image, { ratio: w / h, max: 800 }));
---

<div class="block pair" style={`--img-ratio: ${w} / ${h}`}>
  {
    images.map((image, index) => (
      <figure class="pair__item">
        <div
          class="pair__well"
          style={image.lqip ? `background-image: url(${image.lqip})` : undefined}
        >
          <img
            src={sources[index].src}
            srcset={sources[index].srcset}
            sizes={SIZES.bodyHalf}
            alt={image.alt}
            width={sources[index].width}
            height={sources[index].height}
            loading="lazy"
            decoding="async"
          />
        </div>
        {/* Captions live on each image in the CMS, not in a parallel array. */}
        {image.caption && <figcaption class="pair__caption">{image.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .pair__item {
    margin: 0;
  }

  .pair__well {
    aspect-ratio: var(--img-ratio);
    background-color: var(--surface-sunken);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-0);
    overflow: hidden;
  }

  .pair__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pair__caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  /* Stacking is available under 340px only. */
  @media (max-width: 339px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
