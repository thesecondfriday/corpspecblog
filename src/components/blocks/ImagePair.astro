---
/*
 * Component Spec §4.3 — imagePair.
 *
 * Exactly 2 images, a 14px gap, equal columns, one shared crop (both identical).
 *
 * CALL MADE (§7): the pair STAYS TWO-UP DOWN TO 390px. The 4/5 crop at ~170px
 * wide still reads, and stacking it would break the comparison the pair exists
 * to make. Below 340px it stacks. Captions stay under their own image.
 */
import type { ImageRef } from "../../lib/types";

interface Props {
  images: [ImageRef, ImageRef];
  captions?: [string?, string?];
  ratio?: "4/5" | "3/2" | "1/1";
}

const { images, captions = [], ratio = "4/5" } = Astro.props;

for (const image of images) {
  if (!image.alt) {
    throw new Error(`imagePair: alt is required on both images (§4.3). Missing on ${image.src}.`);
  }
}
---

<div class="block pair" style={`--img-ratio: ${ratio.replace("/", " / ")}`}>
  {
    images.map((image, index) => (
      <figure class="pair__item">
        <div class="pair__well">
          <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
        </div>
        {captions[index] && <figcaption class="pair__caption">{captions[index]}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .pair__item {
    margin: 0;
  }

  .pair__well {
    aspect-ratio: var(--img-ratio);
    background: var(--surface-sunken);
    border-radius: var(--radius-0);
    overflow: hidden;
  }

  .pair__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pair__caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--type-label-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  /* Stacking is available under 340px only. */
  @media (max-width: 339px) {
    .pair {
      grid-template-columns: 1fr;
    }
  }
</style>
