---
/*
 * Component Spec §3.7 — ArticleHeader + HeroFigure.
 *
 * Absent avatar → a 46px --surface-accent circle with the author's initials.
 * Absent heroImage → skip the figure entirely; do NOT substitute the fallback
 * tile at hero scale — the header's white space carries it.
 * Absent caption → no caption row, no rule.
 * Absent readTime/reviewedBy → those meta items disappear. Separators are gaps,
 * not glyphs, so nothing dangles.
 */
import type { Post } from "../lib/types";
import { formatDate, getReadTime, initials } from "../lib/derive";
import { categoryHref } from "../lib/site";
import Chip from "./Chip.astro";
import { SIZES, responsive, urlFor } from "../sanity/lib/image";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const readTime = getReadTime(post);
const hero = post.heroImage;
const caption = [hero?.caption, hero?.credit && `Photo: ${hero.credit}.`].filter(Boolean).join(" ");

/*
 * §3.7 / §7 — two crops, not one image letterboxed by CSS, so the hotspot
 * decides what survives at each width. Square in the split (it sits beside the
 * headline and wants height), 3:2 stacked on mobile, where a full-width square
 * would push the headline below the fold.
 */
const heroSources = hero
  ? {
      mobile: responsive(hero, { ratio: 3 / 2, max: 900 }),
      split: responsive(hero, { ratio: 1, max: 1200 }),
    }
  : null;

const avatarSrc = post.author.avatar
  ? urlFor(post.author.avatar).width(92).height(92).fit("crop").url()
  : null;
---

<header class:list={["container", "art-head", hero && "art-head--split"]}>
  {
    hero && (
      <figure
        class="art-head__media"
        itemprop="image"
        itemscope
        itemtype="https://schema.org/ImageObject"
      >
        <div
          class="art-head__well"
          style={hero.lqip ? `background-image: url(${hero.lqip})` : undefined}
        >
          <picture>
            <source
              media="(min-width: 900px)"
              srcset={heroSources!.split.srcset}
              sizes={SIZES.heroSplit}
            />
            <img
              src={heroSources!.mobile.src}
              srcset={heroSources!.mobile.srcset}
              sizes={SIZES.heroSplit}
              alt={hero.alt}
              itemprop="contentUrl"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
        {caption && (
          <figcaption class="art-head__caption">
            <span class="art-head__flag" aria-hidden="true" />
            <span itemprop="caption">{caption}</span>
          </figcaption>
        )}
      </figure>
    )
  }

  <div class="art-head__text">
    <div class="art-head__titleblock">
    <Chip
      title={post.category.title}
      href={categoryHref(post.category.slug)}
      kind="category"
      style="framed"
    />
    <h1 class="art-head__title" itemprop="headline">{post.title}</h1>
  </div>

  <p class="art-head__dek" itemprop="description">{post.dek}</p>

  <div class="art-head__meta">
    <div class="art-head__byline">
      {
        post.author.avatar ? (
          <img
            class="art-head__avatar"
            src={avatarSrc!}
            alt={post.author.avatar.alt}
            width="46"
            height="46"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="art-head__avatar art-head__avatar--initials" aria-hidden="true">
            {initials(post.author.name)}
          </span>
        )
      }
      <span class="art-head__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
        <span class="art-head__author-name" itemprop="name">{post.author.name}</span>
        {post.author.role && <span class="art-head__author-role" itemprop="jobTitle">{post.author.role}</span>}
      </span>
    </div>

    <time class="art-head__meta-item" itemprop="datePublished" datetime={post.publishedAt}>
      {formatDate(post.publishedAt)}
    </time>
    {readTime && <span class="art-head__meta-item">{readTime} min read</span>}
    {post.reviewedBy && <span class="art-head__meta-item">Reviewed by {post.reviewedBy}</span>}
    </div>
  </div>
</header>


<style>
  /*
   * §3.7 — the split hero. Image left, headline right, both above the fold,
   * directly under the masthead and category nav.
   *
   * The image is CONTAINED, not full-bleed: it shares the container with the
   * text so the two read as one unit. A full-width strip pushed the headline
   * down the page and gave the photograph more weight than the words.
   *
   * With no hero the whole split collapses to a single column (§3.7: absent
   * heroImage skips the figure entirely — never a fallback tile at hero scale).
   */
  .art-head {
    padding-top: clamp(28px, 3.6cqw, 56px);
    padding-bottom: clamp(22px, 2.6cqw, 34px);
    display: grid;
    gap: clamp(24px, 3.4cqw, 56px);
  }

  @media (min-width: 900px) {
    .art-head--split {
      /*
       * The image takes slightly more than half. Even columns made the
       * headline's ragged edge fight the photograph's hard one.
       */
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
    }
  }

  .art-head__text {
    min-width: 0;
  }

  /*
   * No hero: the text is the whole header. Hold it to the article measure and
   * centre it over the body's column — left to itself a headline would run the
   * full container width, far past a comfortable line length.
   */
  .art-head:not(.art-head--split) .art-head__text {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /*
   * §3.7 — title capped at 44ch for a 2–3 line ragged block, not centred.
   *
   * The cap belongs on the h1, not on this wrapper. `ch` resolves against the
   * element's OWN font-size: on the wrapper it measured against the ~19px body
   * size and came out near 400px, which wrapped a 62px display headline over
   * six or seven lines. On the h1 it measures against the display size, the way
   * the dek's 52ch already measures against the dek's. The text column caps the
   * result, giving the 2–3 lines the spec asks for.
   */
  .art-head__title {
    max-width: 44ch;
    margin: var(--space-5) 0 0;
    font-family: var(--font-sans);
    font-size: var(--type-headline-size);
    line-height: var(--type-display-lh);
    letter-spacing: var(--type-display-ls);
    font-weight: var(--type-display-weight);
    color: var(--text-primary);
    text-wrap: balance;
  }

  .art-head__dek {
    margin: var(--space-5) 0 0;
    font-size: var(--type-dek-size);
    line-height: var(--type-dek-lh);
    font-weight: 400;
    color: var(--text-on-accent-body);
    /* §3.7 — dek at 52ch. */
    max-width: 52ch;
  }

  /* Meta row divided from the dek by a 1px --border rule. */
  .art-head__meta {
    margin-top: 28px;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }

  .art-head__byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .art-head__avatar {
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-round);
    object-fit: cover;
    background: var(--surface-sunken);
  }

  .art-head__avatar--initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-accent);
    color: var(--brand-green);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.02em;
  }

  .art-head__author {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .art-head__author-name {
    font-size: var(--type-ui-size);
    font-weight: 700;
    color: var(--text-primary);
  }

  .art-head__author-role,
  .art-head__meta-item {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: var(--type-meta-ls);
    text-transform: uppercase;
    color: var(--text-on-accent-muted);
  }

  .art-head__meta-item {
    font-size: 11px;
  }

  /* ---- Split hero media -------------------------------------------------- */
  .art-head__media {
    margin: 0;
    min-width: 0;
  }

  .art-head__well {
    /*
     * §3.7 Responsive / §7 — 3:2 stacked on mobile. A full-width square there
     * costs the headline its place above the fold.
     */
    aspect-ratio: var(--ratio-hero-mobile);
    background-color: var(--surface-sunken);
    background-size: cover;
    background-position: center;
    border-radius: var(--radius-0);
    overflow: hidden;
  }

  .art-head__well picture,
  .art-head__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 2px --accent flag. The accent flag is reserved for the hero; inline images
     use --border-accent (§4.3). */
  .art-head__caption {
    margin-top: var(--space-3);
    display: flex;
    gap: 10px;
    font-size: var(--type-caption-size);
    line-height: var(--type-caption-lh);
    color: var(--text-caption);
  }

  .art-head__flag {
    width: 2px;
    flex-shrink: 0;
    background: var(--accent);
  }

  @media (min-width: 900px) {
    /* Square in the split — it sits beside the headline and wants the height. */
    .art-head__well {
      aspect-ratio: var(--ratio-hero-split);
    }
  }

  /*
   * The meta row wraps at every width. It used to be held on one line at 900px
   * and up, which worked while the header spanned the container; in the split
   * it has about half that, and nowrap broke the author's name across two lines
   * before it would let the row wrap.
   */
  .art-head__meta {
    flex-wrap: wrap;
  }

  .art-head__byline {
    /* Keep the avatar and name together when the rest of the row wraps past. */
    flex: 0 0 auto;
  }
</style>
