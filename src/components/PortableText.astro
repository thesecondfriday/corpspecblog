---
/*
 * Renders the Portable Text body: §4.1 prose styles inline, §4.2–§4.8 blocks
 * dispatched to their components.
 *
 * Every insertable block carries the `.block` class (applied in the block
 * component itself), which is what the shared spacing law in prose.css keys off.
 */
import type { BodyNode, Heading } from "../lib/types";
import { stripMarks } from "../lib/derive";
import Callout from "./blocks/Callout.astro";
import ComparisonTable from "./blocks/ComparisonTable.astro";
import FaqBlock from "./blocks/FaqBlock.astro";
import ImagePair from "./blocks/ImagePair.astro";
import InlineImage from "./blocks/InlineImage.astro";
import NewsletterSignup from "./NewsletterSignup.astro";
import ProductSpotlight from "./blocks/ProductSpotlight.astro";
import PullQuote from "./blocks/PullQuote.astro";
import ResourceDownload from "./blocks/ResourceDownload.astro";

interface Props {
  body: BodyNode[];
  /** Derived slugs, so heading ids match the TOC anchors exactly. */
  headings: Heading[];
}

const { body, headings } = Astro.props;

/*
 * §4.1 — the drop cap applies to the FIRST PARAGRAPH OF A POST ONLY, and is
 * suppressed if the first block is not a paragraph.
 */
const firstNode = body[0];
const dropcapIndex =
  firstNode && firstNode._type === "block" && firstNode.style === "normal" ? 0 : -1;

// Heading slugs are consumed in document order, matching getHeadings().
let headingCursor = 0;
const slugFor = () => headings[headingCursor++]?.slug;
---

{
  body.map((node, index) => {
    switch (node._type) {
      case "block": {
        if (node.style === "h2") {
          return <h2 id={slugFor()} set:html={node.text} />;
        }
        if (node.style === "h3") {
          return <h3 id={slugFor()} set:html={node.text} />;
        }
        if (node.style === "blockquote") {
          return <blockquote><p set:html={node.text} /></blockquote>;
        }
        return (
          <p class:list={[index === dropcapIndex && "has-dropcap"]} set:html={node.text} />
        );
      }

      case "list": {
        const Tag = node.listItem === "number" ? "ol" : "ul";
        return (
          <Tag>
            {node.items.map((item) => (
              <li set:html={item} />
            ))}
          </Tag>
        );
      }

      case "pullQuote":
        return (
          <PullQuote
            quote={node.quote}
            attribution={node.attribution}
            attributionDetail={node.attributionDetail}
          />
        );

      case "inlineImage":
        return (
          <InlineImage
            image={node.image}
            caption={node.caption}
            credit={node.credit}
            width={node.width}
            ratio={node.ratio}
          />
        );

      case "imagePair":
        return <ImagePair images={node.images} captions={node.captions} ratio={node.ratio} />;

      case "productSpotlight":
        return <ProductSpotlight product={node.product} ctaHref={node.ctaHref} />;

      case "comparisonTable":
        return (
          <ComparisonTable
            label={node.label}
            columns={node.columns}
            rows={node.rows}
            footnote={node.footnote}
            highlightRow={node.highlightRow}
          />
        );

      case "callout":
        return <Callout tone={node.tone} label={node.label} body={node.body} />;

      case "resourceDownload":
        return (
          <ResourceDownload
            title={node.title}
            file={node.file}
            pageCount={node.pageCount}
            description={node.description}
            gated={node.gated}
            formatLabel={node.formatLabel}
            submitLabel={node.submitLabel}
            listId={node.listId}
            reassurance={node.reassurance}
          />
        );

      case "faqBlock":
        return <FaqBlock eyebrow={node.eyebrow} items={node.items} display={node.display} />;

      case "newsletterInline":
        return (
          <div class="block">
            <NewsletterSignup
              placement="inline"
              heading={node.heading}
              body={node.body}
              placeholder={node.placeholder}
              submitLabel={node.submitLabel}
              proofLine={node.proofLine}
              listId={node.listId}
            />
          </div>
        );

      default: {
        // An unknown block type means the CMS shipped a schema the front end
        // does not render. Fail loudly at build rather than dropping content.
        const unknown = node as { _type: string };
        throw new Error(`PortableText: unhandled block type "${unknown._type}"`);
      }
    }
  })
}
