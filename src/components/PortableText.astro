---
/*
 * Renders the article body.
 *
 * Prose, headings, lists and marks (§4.1) go through astro-portabletext, which
 * handles the two things the mock renderer got wrong: text lives in `children[]`
 * spans rather than a flat string, and there is no list *type* — list items are
 * ordinary blocks carrying `listItem`, which the renderer groups into <ul>/<ol>
 * itself.
 *
 * The nine §4 object blocks are mapped to their components by `_type`. Renaming
 * a type in the Studio without renaming it here would render nothing, silently,
 * so `unknownType` fails loudly instead.
 *
 * astro-portabletext passes each component only `{node, index, isInline}` —
 * there is no way to pass extra context down. So anything a block needs to know
 * about its position in the document is annotated onto the node here: heading
 * slugs (shared with the TOC) and the drop cap.
 */
import { PortableText } from "astro-portabletext";
import type { BodyNode, Heading } from "../lib/types";

import Callout from "./blocks/Callout.astro";
import ComparisonTable from "./blocks/ComparisonTable.astro";
import FaqBlock from "./blocks/FaqBlock.astro";
import ImagePair from "./blocks/ImagePair.astro";
import InlineImage from "./blocks/InlineImage.astro";
import NewsletterInline from "./blocks/NewsletterInline.astro";
import ProductSpotlight from "./blocks/ProductSpotlight.astro";
import PullQuote from "./blocks/PullQuote.astro";
import ResourceDownload from "./blocks/ResourceDownload.astro";

import Heading2 from "./prose/Heading2.astro";
import Heading3 from "./prose/Heading3.astro";
import Paragraph from "./prose/Paragraph.astro";
import ProseLink from "./prose/ProseLink.astro";
import UnknownType from "./prose/UnknownType.astro";

interface Props {
  body: BodyNode[];
  /** Derived slugs, so heading ids match the TOC anchors exactly. */
  headings: Heading[];
}

const { body = [], headings } = Astro.props;

const isProse = (node: BodyNode) => node._type === "block";
const styleOf = (node: BodyNode) => (node as { style?: string }).style;
const isListItem = (node: BodyNode) => Boolean((node as { listItem?: string }).listItem);

/*
 * §4.1 — the drop cap applies to the FIRST PARAGRAPH OF A POST ONLY, and is
 * suppressed if the first block is not a paragraph.
 */
const first = body[0];
const dropcapKey =
  first && isProse(first) && styleOf(first) === "normal" && !isListItem(first)
    ? (first as { _key?: string })._key
    : undefined;

/*
 * Heading slugs are consumed in document order, matching getHeadings(), so the
 * anchor a heading renders is by construction the one the TOC links to.
 */
let cursor = 0;
const annotated = body.map((node) => {
  if (isProse(node) && !isListItem(node) && (styleOf(node) === "h2" || styleOf(node) === "h3")) {
    return { ...node, _slug: headings[cursor++]?.slug };
  }
  if ((node as { _key?: string })._key === dropcapKey) {
    return { ...node, _dropcap: true };
  }
  return node;
});
---

<PortableText
  value={annotated}
  components={{
    block: { h2: Heading2, h3: Heading3, normal: Paragraph },
    mark: { link: ProseLink },
    type: {
      pullQuote: PullQuote,
      inlineImage: InlineImage,
      imagePair: ImagePair,
      productSpotlight: ProductSpotlight,
      comparisonTable: ComparisonTable,
      callout: Callout,
      resourceDownload: ResourceDownload,
      faqBlock: FaqBlock,
      newsletterInline: NewsletterInline,
    },
    unknownType: UnknownType,
  }}
/>
