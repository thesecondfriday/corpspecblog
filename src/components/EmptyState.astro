---
/*
 * Component Spec §3.6 — EmptyState.
 *
 * Bordered block (1px --border, no fill), left-aligned, max 62ch.
 * Never an illustration, never centred.
 *
 * The filter row and pagination both remain visible above and below — this
 * replaces the grid only.
 */
import { SITE } from "../lib/site";

interface Props {
  context: "filteredArchive" | "emptyCategory" | "search";
  /** Echoed verbatim in the headline. */
  activeFilters?: string[];
  categoryTitle?: string;
  categoryCount?: number;
  clearHref: string;
  strategistHref?: string;
}

const {
  context,
  activeFilters = [],
  categoryTitle,
  categoryCount,
  clearHref,
  strategistHref = SITE.strategistHref,
} = Astro.props;

const filterLabel = activeFilters.join(" + ");

const headline =
  context === "emptyCategory"
    ? `Nothing published in ${categoryTitle} yet.`
    : activeFilters.length > 0
      ? `Nothing filed under “${filterLabel}” yet.`
      : `Nothing here yet.`;

const body =
  context === "emptyCategory"
    ? `This category is live but has no published pieces. Browse everything on the hub, or ask a strategist directly — we answer questions like this several times a week.`
    : `That combination is new. Clear a filter to widen the search, browse the ${categoryCount} pieces in ${categoryTitle}, or ask a strategist directly — this is a question we answer several times a week.`;

// §3.6 — for emptyCategory the secondary action becomes "Browse all stories".
const secondary =
  context === "emptyCategory"
    ? { label: "Browse all stories", href: SITE.blogBase }
    : { label: SITE.strategistLabel, href: strategistHref };
---

<div class="empty">
  <span class="empty__monogram" aria-hidden="true">CS</span>
  <h2 class="empty__headline">{headline}</h2>
  <p class="empty__body">{body}</p>
  <div class="empty__actions">
    {
      context === "emptyCategory" ? (
        <a class="btn btn--ink" href={SITE.strategistHref}>
          {SITE.strategistLabel}
        </a>
      ) : (
        <a class="btn btn--ink" href={clearHref}>
          Clear filters
        </a>
      )
    }
    <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>
  </div>
</div>

<style>
  .empty {
    border: 1px solid var(--border);
    padding: clamp(32px, 5cqw, 76px) clamp(20px, 4cqw, 56px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 62ch;
  }

  .empty__monogram {
    font-family: var(--font-serif);
    font-size: 46px;
    line-height: 1;
    color: var(--border-accent);
  }

  .empty__headline {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--type-h2-size);
    line-height: var(--type-h2-lh);
    letter-spacing: var(--type-h2-ls);
    font-weight: 800;
    color: var(--text-primary);
  }

  .empty__body {
    margin: 0;
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-lh);
    color: var(--text-muted);
  }

  .empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: var(--space-1);
  }

  /* §3.6 Responsive — mobile: padding drops to --space-6, buttons stack full-width. */
  @media (max-width: 599px) {
    .empty {
      padding: var(--space-6);
    }

    .empty__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
