---
/*
 * CATEGORY / ARCHIVE — page 1 at /blog/{category}, page 2+ at
 * /blog/{category}/page/{n} (§3.4).
 *
 * The same card grid as the index, with no hero treatment. CALL MADE (§7): the
 * `featured` card variant never appears on an archive — it is reserved for the
 * index.
 *
 * The tag filter row renders as real links with live counts, but narrowing is
 * not wired: with static output a ?tag= query cannot re-render server-side.
 * See IMPLEMENTATION-NOTES.md — the choice between a static route
 * (/blog/{category}/tag/{tag}) and client-side filtering is still open, and it
 * is the same decision that decides whether the §3.3 skeleton is ever real.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CategoryHeader from "../../../components/CategoryHeader.astro";
import Chip from "../../../components/Chip.astro";
import EmptyState from "../../../components/EmptyState.astro";
import Pagination from "../../../components/Pagination.astro";
import PostGrid from "../../../components/PostGrid.astro";
import { categoryHref, pageHref } from "../../../lib/site";
import { PAGE_SIZE, paginate } from "../../../lib/paginate";
import { sanityApi } from "../../../sanity/lib/queries";

export async function getStaticPaths() {
  const { sanityApi } = await import("../../../sanity/lib/queries");
  const { PAGE_SIZE } = await import("../../../lib/paginate");

  const categories = await sanityApi.categoryPaths();

  return categories.flatMap((category) => {
    // A category with no posts still gets page 1 — that is the §3.6 empty state,
    // not a missing route.
    const totalPages = Math.max(1, Math.ceil(category.total / PAGE_SIZE));

    return Array.from({ length: totalPages }, (_, i) => ({
      params: { category: category.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { page: i + 1 },
    }));
  });
}

const { category: categorySlug } = Astro.params;
const { page } = Astro.props;

const [categories, posts, filterTags] = await Promise.all([
  sanityApi.allCategories(),
  sanityApi.postsInCategory(categorySlug!),
  sanityApi.tagsInCategory(categorySlug!),
]);

const category = categories.find((c) => c.slug === categorySlug);
if (!category) return new Response(null, { status: 404 });

const count = category.postCount ?? posts.length;
const paged = paginate(posts, page, PAGE_SIZE);
const basePath = categoryHref(categorySlug!);

// §3.4 Page 2+ — the eyebrow becomes "Page {n}" and the range label
// "{from}–{to} of {total}".
const feedLabel = page === 1 ? "Latest" : `Page ${page}`;
const rangeLabel = `${paged.from}–${paged.to} of ${paged.total}`;
---

<BaseLayout
  title={page === 1 ? category.title : `${category.title} — Page ${page}`}
  description={category.description}
  categories={categories}
  activeSlug={categorySlug}
  canonical={pageHref(basePath, page)}
  prev={page > 1 ? pageHref(basePath, page - 1) : undefined}
  next={page < paged.totalPages ? pageHref(basePath, page + 1) : undefined}
>
  {/* §3.5 — on page 2+ the header is unchanged; it is not a page-specific element. */}
  <CategoryHeader category={category} postCount={count} />

  {
    filterTags.length > 0 && (
      <div class="container filters">
        <div class="scroll-x filters__row">
          <Chip title={`All ${count}`} href={basePath} kind="tag" isActive />
          {filterTags.map((tag) => (
            <Chip
              title={tag.title}
              href={`${basePath}?tag=${tag.slug}`}
              kind="tag"
              count={tag.count}
            />
          ))}
        </div>
      </div>
    )
  }

  <section class="container archive">
    {/*
     * §3.6 — the empty state replaces the grid only; the filter row above and
     * the pagination below both stay visible.
     */}
    <PostGrid
      posts={paged.items}
      label={paged.items.length > 0 ? feedLabel : undefined}
      rangeLabel={paged.items.length > 0 ? rangeLabel : undefined}
      state={paged.items.length > 0 ? "ready" : "empty"}
    >
      <EmptyState
        slot="empty"
        context="emptyCategory"
        categoryTitle={category.title}
        categoryCount={count}
        clearHref={basePath}
      />
    </PostGrid>

    <Pagination currentPage={page} totalPages={paged.totalPages} basePath={basePath} />
  </section>
</BaseLayout>

<style>
  .filters {
    padding-top: clamp(22px, 2.6cqw, 34px);
  }

  .filters__row {
    display: flex;
    gap: var(--space-2);
    padding-bottom: var(--space-1);
  }

  .archive {
    padding-top: clamp(26px, 3.4cqw, 44px);
    padding-bottom: var(--section-y);
  }

  /* §3.2 Responsive — desktop+: the filter row wraps to two lines maximum. */
  @media (min-width: 900px) {
    .filters__row {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
</style>
