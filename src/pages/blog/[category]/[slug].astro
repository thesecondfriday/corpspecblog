---
/*
 * SINGLE POST — /blog/{category}/{slug}. Prerendered from Sanity.
 *
 * The body lives in PostView so the draft preview route renders exactly this
 * layout rather than a copy of it.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostView from "../../../components/PostView.astro";
import { resolveRelated } from "../../../lib/paginate";
import { blogPostingSchema, breadcrumbSchema, faqPageSchema } from "../../../lib/schema";
import { sanityApi } from "../../../sanity/lib/queries";
import "../../../styles/prose.css";

export async function getStaticPaths() {
  /*
   * Astro hoists getStaticPaths into its own module context, so anything it
   * uses must be imported or defined inside it — module-scope consts in the
   * frontmatter are not in scope here.
   */
  const { sanityApi } = await import("../../../sanity/lib/queries");
  const paths = await sanityApi.postPaths();

  return paths
    // A post whose category reference is missing or unpublished has no route.
    .filter((p) => p.category && p.slug)
    .map((p) => ({ params: { category: p.category, slug: p.slug } }));
}

const { slug } = Astro.params;

const [post, categories] = await Promise.all([
  sanityApi.postBySlug(slug!),
  sanityApi.allCategories(),
]);

if (!post) {
  // getStaticPaths built this route from the same dataset, so this only fires
  // if a document was deleted mid-build.
  return new Response(null, { status: 404 });
}

// Flag 6 — the manual field wins; the algorithm tops up whatever it doesn't fill.
const pool = post.relatedPosts && post.relatedPosts.length >= 3
  ? []
  : await sanityApi.relatedFallback(post.slug, post.category.slug);
const related = resolveRelated(post, pool);

const hasBodyFaq = (post.body ?? []).some((node) => node._type === "faqBlock");
const faqForSchema = hasBodyFaq
  ? (post.body.find((node) => node._type === "faqBlock") as { items?: unknown[] } | undefined)?.items
  : post.faq;

const schemas = [
  blogPostingSchema(post),
  breadcrumbSchema(post),
  ...(faqForSchema?.length ? [faqPageSchema(faqForSchema as never)] : []),
];
---

<BaseLayout
  title={post.seo?.metaTitle ?? post.title}
  description={post.seo?.metaDescription ?? post.dek}
  categories={categories}
  activeSlug={post.category.slug}
  canonicalOverride={post.seo?.canonical}
  noindex={post.seo?.noindex}
  ogImage={post.seo?.ogImage?.src ?? post.heroImage?.src}
  schemas={schemas}
>
  <PostView post={post} related={related} />
</BaseLayout>
